<launch>
    <arg name="pipeline_path"/>
    <arg name="hydra_ros_ns" default="hydra_ros_node"/>

    <arg name="semantic_map_path" default="''"/>
    <arg name="semantic_label_remap_filepath" default="''"/>
    <arg name="exit_after_clock" default="false"/>
    <arg name="log_path" default="$(find hydra)/output/$(arg dataset_name)"/>
    <arg name="log_timing_incrementally" default="false"/>
    <arg name="disable_timer_output" default="true"/>
    <arg name="timing_disabled" default="false"/>

    <!-- Frontend configuration -->
    <arg name="enable_frontend_output" default="true"/>
    <arg name="enable_places" default="true"/>
    <arg name="bounding_box_type" default="AABB"/>
    <arg name="use_gt_frame" default="true"/>
    <arg name="pose_graph_tracker_type" default="$(eval 'PoseGraphFromOdom' if use_gt_frame else 'RosPoseGraphs')"/>

    <!-- Backend configuration -->
    <arg name="add_initial_prior" default="true"/>
    <arg name="optimize_on_lc" default="true"/>
    <arg name="enable_zmq_interface" default="true"/>
    <arg name="zmq_ip" default="127.0.0.1"/>
    <arg name="zmq_send_url" default="tcp://$(arg zmq_ip):8001"/>
    <arg name="zmq_recv_url" default="tcp://$(arg zmq_ip):8002"/>
    <arg name="zmq_send_mesh" default="true"/>

    <!-- Flow temporal configuration -->
    <arg name="enable_flow_temporal_module" default="true"/> <!-- enable temporal flow module -->
    <arg name="flow_temporal_observations_topic" default="/people_detections_odom"/> <!-- odom_array input topic -->
    <arg name="flow_temporal_use_detection_stamp_for_tf" default="true"/> <!-- use detection stamp for TF lookup -->
    <arg name="flow_temporal_min_tsdf_weight_for_visibility" default="0.001"/> <!-- active-voxel weight threshold -->
    <arg name="flow_temporal_worker_rate_hz" default="5.0"/> <!-- how often queued detections are processed -->
    <arg name="flow_temporal_heavy_maintenance_rate_hz" default="0.0333"/> <!-- how often expensive maintenance tasks run (loop-closure remaps) -->
    <arg name="flow_temporal_max_queue_size" default="10"/> <!-- max buffered detection frames; oldest frames are dropped when full -->
    <arg name="flow_temporal_prediction_horizon_s" default="1.0"/> <!-- future horizon used for presence probability and place summaries -->
    <arg name="flow_temporal_place_summary_max_nodes" default="2000"/> <!-- max place/mesh nodes summarized per backend update -->
    <arg name="flow_temporal_max_components_per_place" default="8"/> <!-- max retained components in place metadata -->
    <arg name="flow_temporal_component_min_weight" default="0.0"/> <!-- drop place components below this normalized weight -->
    <arg name="flow_temporal_deformation_knn" default="4"/> <!-- KNN used by deformation graph point deformation -->
    <arg name="flow_temporal_deformation_tolerance_s" default="10.0"/> <!-- deformation graph temporal tolerance -->
    <arg name="flow_temporal_debug_metrics_nodes_only" default="false"/> <!-- publish compact JSON node metrics payload -->
    <!-- Kairos flow model. Defaults are the paper's ATC/HB configuration; the dataset-scale ones (candidate periods, presence rate window) are set per deployment. -->
    <arg name="flow_temporal_flow_fixed_mu_rho" default="1.1"/> <!-- speed (m/s) a slot reports before any speed has been observed -->
    <arg name="flow_temporal_flow_fixed_sigma_theta" default="0.4"/> <!-- angular spread of every slot (rad) -->
    <arg name="flow_temporal_flow_fixed_sigma_rho" default="0.3"/> <!-- speed spread of every slot (m/s); prior spread of the speed uncertainty -->
    <arg name="flow_temporal_flow_fixed_sigma_cross" default="0.0"/> <!-- heading-speed covariance -->
    <arg name="flow_temporal_flow_speed_scatter_prior_obs" default="5.0"/> <!-- weight (in observations) of fixed_sigma_rho in the speed uncertainty -->
    <arg name="flow_temporal_flow_candidate_periods" default="[3600.0, 43200.0, 86400.0, 604800.0]"/> <!-- candidate periods (s): 1 h, 12 h, daily, weekly -->
    <arg name="flow_temporal_flow_presence_rate_window_s" default="120.0"/> <!-- presence exposure window (s); well below the shortest candidate period -->
    <arg name="flow_temporal_flow_nudft_order" default="10"/> <!-- highest spectral order the per-cell gate may select -->
    <arg name="flow_temporal_flow_nudft_min_obs" default="10"/> <!-- samples a predictor needs before it is trusted -->
    <arg name="flow_temporal_flow_visit_gap_s" default="2.0"/> <!-- a track's visit to a cell closes after this silence (s) -->
    <arg name="flow_temporal_flow_visit_max_s" default="10.0"/> <!-- hard cap on a visit's span (s) -->
    <arg name="flow_temporal_flow_voxel_size_m" default="0.4"/> <!-- flow voxel side (m); must match the reconstruction voxel size -->
    <arg name="flow_temporal_flow_sharing_lent_crossings" default="3.0"/> <!-- evidence sharing: crossings lent by the traversable neighbourhood -->
    <arg name="flow_temporal_flow_weight_uncertainty_noise_sigma" default="0.3"/> <!-- observation noise of the mixing-weight posterior -->
    <arg name="flow_temporal_flow_edge_coupling_connectivity" default="6"/> <!-- coupling neighbourhood: 6 = face-adjacent, 26 = full cube -->
    <arg name="flow_temporal_flow_edge_coupling_delta_t_coh" default="1.0"/> <!-- window (s) within which two detections co-occur -->
    <arg name="flow_temporal_flow_edge_coupling_samples_per_period" default="12"/> <!-- coupling samples per shortest candidate period -->
    <arg name="flow_temporal_flow_edge_coupling_window_min_pairs" default="2"/> <!-- pairs a coupling window needs before it closes -->
    <arg name="flow_temporal_flow_enable_timing" default="false"/> <!-- aggregate flow timing logs -->
    <arg name="flow_temporal_debug_metrics_max_nodes" default="50"/> <!-- max nodes emitted in debug metrics payload -->
    <arg name="flow_temporal_publish_metrics" default="true"/> <!-- publish text/JSON debug metrics -->
    <arg name="flow_temporal_metrics_topic" default="temporal/flow_metrics"/> <!-- debug metrics topic -->

    <!-- LCD pipeline configuration -->
    <arg name="enable_dsg_lcd" default="false"/>
    <arg name="lcd_use_bow_vectors" default="true"/>
    <arg name="use_gnn_descriptors" default="false"/>
    <arg name="lcd_gnn_object_model" default="$(find hydra)/models/lcd/object_gnn.onnx"/>
    <arg name="lcd_gnn_places_model" default="$(find hydra)/models/lcd/place_gnn.onnx"/>
    <arg name="lcd_gnn_label_embeddings" default="''"/>

    <!-- Openset feature configuration -->
    <arg name="use_openset_features" default="false"/>
    <arg name="feature_receiver_type" value="$(eval 'FeatureReceiver' if use_openset_features else '&quot;&quot;')"/>

    <rosparam file="$(arg pipeline_path)" subst_value="true" ns="$(arg hydra_ros_ns)"/>
</launch>
